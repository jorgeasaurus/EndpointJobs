# Free Carto basemap key from https://carto.com/basemaps/apikey; appended to the tile URL as ?key=; NEXT_PUBLIC_ values are baked into the client JS at build time, so set this for the build, not only runtime.
NEXT_PUBLIC_CARTO_API_KEY=

# Optional: enables confidence-gated JEV classification for listings unresolved by exact rules.
TYPESAFE_API_KEY=
JOB_JEV_MAX_REQUESTS=50
JOB_JEV_TIMEOUT_MS=8000
JOB_JEV_MAX_RETRIES=0
